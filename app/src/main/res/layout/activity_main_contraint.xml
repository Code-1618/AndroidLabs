<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/lab2_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:text="@string/lab2_label"
        android:textSize="30dp"
        android:textColor="#233F60"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/lab2_flag" />

    <ImageButton
        android:id="@+id/lab2_flag"
        android:layout_width="104dp"
        android:layout_height="76dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/flag"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:contentDescription="@string/flag_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Switch
        android:id="@+id/lab2_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/lab2_switch"
        app:layout_constraintTop_toBottomOf="@id/lab2_textview"
        app:layout_constraintStart_toStartOf="@id/lab2_textview" />

    <Button
        android:id="@+id/lab2_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        android:text="@string/lab2_button"
        android:backgroundTint="#233F60"
        app:layout_constraintTop_toBottomOf="@id/lab2_flag"
        app:layout_constraintStart_toStartOf="parent" />

    <CheckBox
        android:id="@+id/lab2_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="@string/lab2_checkbox"
        app:layout_constraintTop_toTopOf="@id/lab2_button"
        app:layout_constraintBottom_toBottomOf="@id/lab2_button"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/lab2_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:hint="@string/lab2_hint"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/lab2_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
