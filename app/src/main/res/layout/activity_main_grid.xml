<?xml version="1.0" encoding="utf-8"?>
<GridLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="2"
    android:rowCount="4">

    <TextView
        android:id="@+id/lab2_textview"
        android:layout_row="0"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_marginStart="16dp"
        android:text="@string/lab2_label"
        android:textSize="30dp"
        android:textColor="#233F60" />

    <ImageButton
        android:id="@+id/lab2_flag"
        android:layout_row="0"
        android:layout_column="1"
        android:layout_rowSpan="2"
        android:layout_width="104dp"
        android:layout_height="76dp"
        android:layout_marginEnd="16dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/flag"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:contentDescription="@string/flag_description" />

    <Switch
        android:id="@+id/lab2_switch"
        android:layout_row="1"
        android:layout_column="0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/lab2_switch" />

    <Button
        android:id="@+id/lab2_button"
        android:layout_row="2"
        android:layout_column="0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:text="@string/lab2_button"
        android:backgroundTint="#233F60" />

    <CheckBox
        android:id="@+id/lab2_checkbox"
        android:layout_row="2"
        android:layout_column="1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        android:layout_gravity="center_vertical"
        android:text="@string/lab2_checkbox" />

    <EditText
        android:id="@+id/lab2_input"
        android:layout_row="3"
        android:layout_column="0"
        android:layout_columnSpan="2"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:hint="@string/lab2_hint"
        android:inputType="text" />

</GridLayout>
